	column País = SWITCH ( pais[sigla_iso], "BR", "Brasil", "AR", "Argentina", "CL", "Chile", "CO", "Colômbia", "PE", "Peru", pais[nome_pais] )
		lineageTag: a7e03e20-2a70-4c3e-979b-56cf258422c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Região nº' = SWITCH ( TRUE (), pais[sigla_iso] IN { "BR", "AR", "CL", "CO", "PE", "MX" }, 1, pais[sigla_iso] IN { "US" }, 2, pais[sigla_iso] IN { "GB", "FR", "IT", "ES", "DE", "IE", "PL", "SE", "DK", "HU", "NL", "MK" }, 3, 4 )
		isHidden
		formatString: 0
		lineageTag: 69d3519f-881e-41ab-b8cf-82eb9ec6960a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Região = SWITCH ( TRUE (), pais[sigla_iso] IN { "BR", "AR", "CL", "CO", "PE", "MX" }, "América Latina", pais[sigla_iso] IN { "US" }, "América do Norte", pais[sigla_iso] IN { "GB", "FR", "IT", "ES", "DE", "IE", "PL", "SE", "DK", "HU", "NL", "MK" }, "Europa", "Ásia e Oriente Médio" )
		lineageTag: 1d33c1c9-92b6-426b-8c33-dd71d08a6761
		summarizeBy: none
		sortByColumn: 'Região nº'

		annotation SummarizationSetBy = Automatic

