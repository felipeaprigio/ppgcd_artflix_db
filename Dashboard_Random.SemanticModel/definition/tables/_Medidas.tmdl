		lineageTag: a41705f2-409f-458d-b228-ef4d8d3c9893

	measure '% sem metadado' = IF ( COUNTROWS ( titulo ) > 0, 1 - [% metadado completo] )
		formatString: 0.0%;-0.0%;0.0%
