	measure 'Registros de uso anonimizados' =
			CALCULATE ( COUNTROWS ( sessoes ), NOT ISBLANK ( sessoes[data_anonimizacao] ), REMOVEFILTERS ( Calendario ) )
			    + CALCULATE ( COUNTROWS ( login ), NOT ISBLANK ( login[data_anonimizacao] ) )
			    + CALCULATE ( COUNTROWS ( pesquisa ), NOT ISBLANK ( pesquisa[data_anonimizacao] ) ) + 0
		formatString: #,0
		lineageTag: 34bb5dfc-3b0b-4cf6-854e-e904ea839340

	column 'Coluna 1'
