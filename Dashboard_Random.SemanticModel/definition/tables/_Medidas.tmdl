	measure 'ARPU Brasil' = ```
			
			        CALCULATE (
			            AVERAGE ( assinatura[valor_contratado] ),
			            assinatura[moeda] = "BRL",
			            ISBLANK ( assinatura[data_cancelamento] )
			        )
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 9aadf381-dc68-48e5-91a8-739ac27d4a5a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Base no fim do mês' =
			VAR fim = MAX ( Calendario[Data] ) + 1
			RETURN
			    COUNTROWS (
			        FILTER (
			            assinatura,
			            assinatura[data_inicio] < fim
			                && ( ISBLANK ( assinatura[data_cancelamento] ) || assinatura[data_cancelamento] >= fim )
			        )
			    )
		formatString: #,0
		lineageTag: 7239ee78-ac1c-4d3a-8a73-b8b70ea95d44

	measure 'Base no início do mês' = ```
			
			        VAR ini = MIN ( Calendario[Data] )
			        RETURN
			            COUNTROWS (
			                FILTER (
			                    assinatura,
			                    assinatura[data_inicio] < ini
			                        && ( ISBLANK ( assinatura[data_cancelamento] )
			                             || assinatura[data_cancelamento] >= ini )
			                )
			            )
			```
		formatString: 0
		lineageTag: db7e0bee-6b7a-4036-8087-b298233f214f

	measure 'Cancelamentos no período' = ```
			
			        VAR ini = MIN ( Calendario[Data] )
			        VAR fim = MAX ( Calendario[Data] ) + 1
			        RETURN
			            COUNTROWS (
			                FILTER (
			                    assinatura,
			                    assinatura[data_cancelamento] >= ini
			                        && assinatura[data_cancelamento] < fim
			                )
			            )
			```
		formatString: 0
		lineageTag: 970f97c3-986b-43f7-8cb0-e44208ce9092

	measure 'Churn mensal %' =
			VAR meses = VALUES ( Calendario[Mês nº] )
			RETURN
			    DIVIDE (
			        SUMX ( meses, [Cancelamentos no período] ),
			        SUMX ( meses, [Base no início do mês] )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 218b0d55-4a71-4f19-83aa-80339d9e4917

	measure 'Churn no ano %' = ```
			
			        DIVIDE (
			            CALCULATE ( COUNTROWS ( assinatura ), NOT ISBLANK ( assinatura[data_cancelamento] ) ),
			            COUNTROWS ( assinatura )
			        )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 37cc46c4-7b6b-442b-b9f2-8c1edc9b0177

