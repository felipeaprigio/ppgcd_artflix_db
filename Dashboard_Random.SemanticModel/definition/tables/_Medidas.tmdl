	measure 'Titulares anonimizados' =
			VAR ini = MIN ( Calendario[Data] )
			VAR fim = MAX ( Calendario[Data] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( assinante ),
			        assinante[situacao_cadastro] = "ANONIMIZADO",
			        assinante[data_anonimizacao] >= ini,
			        assinante[data_anonimizacao] < fim + 1,
			        CROSSFILTER ( assinatura[cod_assinante], assinante[cod_assinante], BOTH )
			    ) + 0
		formatString: #,0
		lineageTag: 1b791374-9b77-41f9-ab38-6a7ab51c215f

	measure 'Prazo médio LGPD (dias)' =
			VAR ini = MIN ( Calendario[Data] )
			VAR fim = MAX ( Calendario[Data] )
			RETURN
			    CALCULATE (
			        AVERAGEX (
			            FILTER ( assinante, NOT ISBLANK ( assinante[data_anonimizacao] ) ),
			            DATEDIFF ( assinante[data_solicitacao_exclusao], assinante[data_anonimizacao], DAY )
			        ),
			        assinante[data_anonimizacao] >= ini,
			        assinante[data_anonimizacao] < fim + 1,
			        CROSSFILTER ( assinatura[cod_assinante], assinante[cod_assinante], BOTH )
			    )
		formatString: 0.0
		lineageTag: d541b9a1-5013-45f5-9c17-a4f2466394cb

