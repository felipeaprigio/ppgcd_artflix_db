	measure 'Receita mensal (US$)' =
			VAR fim = MAX ( Calendario[Data] )
			VAR comp = FORMAT ( fim, "yyyy-MM" )
			VAR ativos =
			    FILTER (
			        assinatura,
			        assinatura[data_inicio] < fim + 1
			            && ( ISBLANK ( assinatura[data_cancelamento] ) || assinatura[data_cancelamento] >= fim + 1 )
			    )
			VAR porMoeda =
			    GROUPBY ( ativos, assinatura[moeda], "@valor", SUMX ( CURRENTGROUP (), assinatura[valor_contratado] ) )
			RETURN
			    SUMX (
			        porMoeda,
			        [@valor] / LOOKUPVALUE ( cotacao[taxa_usd], cotacao[moeda], assinatura[moeda], cotacao[competencia], comp )
			    )
		formatString: "US$"\ #,0;-"US$"\ #,0;"US$"\ #,0
		lineageTag: 1036090b-d86f-4f60-89b4-468b08b9f7f8

	measure 'ARPU (US$)' = DIVIDE ( [Receita mensal (US$)], [Base no fim do mês] )
		formatString: "US$"\ #,0.00;-"US$"\ #,0.00;"US$"\ #,0.00
		lineageTag: f1d65ac3-83e9-4427-80d9-effd71815bb4

	measure 'Receita no período (US$)' =
			VAR t =
			    CALCULATETABLE (
			        SUMMARIZE ( cobranca, cobranca[competencia], cobranca[moeda] ),
			        TREATAS ( VALUES ( Calendario[Competência] ), cobranca[competencia] )
			    )
			RETURN
			    SUMX (
			        t,
			        CALCULATE ( SUM ( cobranca[valor_cobrado] ) )
			            / LOOKUPVALUE ( cotacao[taxa_usd], cotacao[moeda], cobranca[moeda], cotacao[competencia], cobranca[competencia] )
			    )
		formatString: "US$"\ #,0.00;-"US$"\ #,0.00;"US$"\ #,0.00
		lineageTag: b05cb434-283c-49c8-b37b-e27a54108ee8

	measure 'Receita no período (US$ mi)' = DIVIDE ( [Receita no período (US$)], 1000000 )
		formatString: 0.0" mi"
		lineageTag: a461688a-4985-49b7-b57b-6cb0b1c54f8a

	measure 'Custo de licenças no período (US$)' =
			VAR ini = MIN ( Calendario[Data] )
			VAR fim = MAX ( Calendario[Data] )
			RETURN
			    SUMX (
			        janela,
			        VAR a = MAX ( janela[data_inicio], ini )
			        VAR b = MIN ( janela[data_fim], fim )
			        VAR dias = INT ( b - a ) + 1
			        RETURN
			            IF ( dias > 0, janela[Valor licença (US$)] * dias / ( INT ( janela[data_fim] - janela[data_inicio] ) + 1 ) )
			    )
		formatString: "US$"\ #,0.00;-"US$"\ #,0.00;"US$"\ #,0.00
		lineageTag: b397e03c-233b-48c0-9522-2c5ecff84bcc

	measure 'Custo por hora assistida (US$)' = DIVIDE ( [Custo de licenças no período (US$)], [Horas assistidas] )
		formatString: "US$"\ #,0.00;-"US$"\ #,0.00;"US$"\ #,0.00
		lineageTag: a22fc206-ba64-43cb-ac88-b41a81e6e7f8

	measure 'Custo por hora US$ (Top 10)' =
			IF (
			    NOT ISBLANK ( [Custo por hora assistida (US$)] )
			        && RANKX ( ALLSELECTED ( titulo[nome_titulo] ), [Custo por hora assistida (US$)], , DESC ) <= 10,
			    [Custo por hora assistida (US$)]
			)
		formatString: "US$"\ #,0.00;-"US$"\ #,0.00;"US$"\ #,0.00
		lineageTag: d742df68-8874-4cd2-a92e-050f19616eea

	measure 'Títulos licenciados' =
			VAR ini = MIN ( Calendario[Data] )
			VAR fim = MAX ( Calendario[Data] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( janela[cod_titulo] ),
			        FILTER ( janela, janela[data_inicio] <= fim && janela[data_fim] >= ini )
			    ) + 0
		formatString: #,0
		lineageTag: 6fbdf357-a929-45f8-91aa-b3db12921ae3

	measure 'Dias para vencer (90 dias)' =
			VAR fim = MAX ( Calendario[Data] )
			VAR d = INT ( MAX ( janela[data_fim] ) - fim )
			RETURN
			    IF ( HASONEVALUE ( janela[cod_janela] ) && d >= 0 && d <= 90, d )
		formatString: 0
		lineageTag: d55ab375-dc4c-499f-b606-1e4fab9046a8

	measure 'Incidentes OE4' =
			VAR ini = MIN ( Calendario[Data] )
			VAR fim = MAX ( Calendario[Data] )
			RETURN
			    COUNTROWS (
			        FILTER ( janela, janela[Exibições fora] > 0 && janela[data_fim] + 1 >= ini && janela[data_fim] + 1 <= fim )
			    ) + 0
		formatString: 0
		lineageTag: 3a64ce5b-2a48-4e70-9eae-e92d01d79dbd

	measure 'Exibições OE4 (lista)' =
			VAR ini = MIN ( Calendario[Data] )
			VAR fim = MAX ( Calendario[Data] )
			VAR n =
			    SUMX (
			        FILTER ( janela, janela[data_fim] + 1 >= ini && janela[data_fim] + 1 <= fim ),
			        janela[Exibições fora]
			    )
			RETURN
			    IF ( n > 0, n )
		formatString: #,0
		lineageTag: b3fc14ec-5f06-45d6-b104-b1ed803e9532

	measure '% completo' = [% metadado completo]
