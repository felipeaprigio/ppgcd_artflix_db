	measure 'Taxa de conclusão %' = ```
			
			        DIVIDE (
			            COUNTROWS (
			                FILTER (
			                    sessoes,
			                    sessoes[segundos_assistidos] >= 0.85 * RELATED ( titulo[duracao_segundos] )
			                )
			            ),
			            COUNTROWS ( sessoes )
			        )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 71a28c0f-c9e2-4e12-ae9e-55dc59b48d91

