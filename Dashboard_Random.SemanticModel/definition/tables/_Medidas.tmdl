table _Medidas
	lineageTag: 339fdfd2-7f62-4764-aec0-8e0ad957e7d0

	measure 'Assinaturas ativas' = ```
			
			        CALCULATE ( COUNTROWS ( assinatura ), ISBLANK ( assinatura[data_cancelamento] ) )
			```
		formatString: 0
		lineageTag: 982f810d-fecc-479d-a4f6-ab5540ff5435

	measure 'Receita mensal (R$)' = ```
			
			        CALCULATE (
			            SUM ( assinatura[valor_contratado] ),
			            assinatura[moeda] = "BRL",
			            ISBLANK ( assinatura[data_cancelamento] )
			        )
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 53e33576-0f1f-4aaf-8de5-dc95025c7f6e

