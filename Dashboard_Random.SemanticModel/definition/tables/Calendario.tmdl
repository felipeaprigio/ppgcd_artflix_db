	partition Calendario = calculated
		mode: import
		source =
				
				VAR base = CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2026, 9, 30 ) )
				RETURN
				    SELECTCOLUMNS (
				        base,
				        "Data", [Date],
				        "Mês nº", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Mês", FORMAT ( [Date], "mmm/yy" ),
				        "Dia da semana nº", WEEKDAY ( [Date], 2 ),
				        "Dia da semana", FORMAT ( [Date], "ddd" ),
				        "Tipo de dia", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Fim de semana", "Dia útil" ),
				        "Trimestre nº", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ),
				        "Trimestre", YEAR ( [Date] ) & " · T" & QUARTER ( [Date] ),
				        "Competência", FORMAT ( [Date], "yyyy-MM" )
				    )

	annotation PBI_Id = ee3dbf091218432a83a1afd53868489c

