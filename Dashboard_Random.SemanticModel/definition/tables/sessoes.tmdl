	column Data = DATE ( YEAR ( sessoes[data_hora_inicio] ), MONTH ( sessoes[data_hora_inicio] ), DAY ( sessoes[data_hora_inicio] ) )
		formatString: dd/mm/yyyy
		lineageTag: 0649e8ef-5e5a-4b23-a56c-b3d430356f7b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column Hora = HOUR ( sessoes[data_hora_inicio] )
		formatString: 0
		lineageTag: 2a7ed489-91e6-4856-8b7e-e30cecf5cbb5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'País da sessão' = LOOKUPVALUE ( pais[País], pais[cod_pais], sessoes[cod_pais] )
		lineageTag: 0d8a1239-30a3-47c9-b678-39dac7c52d89
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Janela início' = LOOKUPVALUE ( janela[data_inicio], janela[cod_janela], sessoes[cod_janela] )
		formatString: dd/mm/yyyy
		lineageTag: 77ddca48-46e5-408e-bf66-ff55a0241884
