			defaultHierarchy: LocalDateTable_420df278-38b1-4165-91ab-9dbb984c5f1f.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'Janela fim' = LOOKUPVALUE ( janela[data_fim], janela[cod_janela], sessoes[cod_janela] )
		formatString: dd/mm/yyyy
		lineageTag: 3b3f3c8c-c5bc-4fa4-99a2-9d521081700e
		summarizeBy: none

		variation Variation
			isDefault
			relationship: ff966a80-a1da-4830-ae3b-283a0f780abe
			defaultHierarchy: LocalDateTable_7d937a1a-7bd5-4487-a3fc-ec09eff609b6.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column 'Fora da janela' = IF ( sessoes[Data] < sessoes[Janela início] || sessoes[Data] > sessoes[Janela fim], 1, 0 )
		formatString: 0
		lineageTag: 3e74dde5-ad3f-41f6-93c3-f9f65567223b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition sessoes = m
		mode: import
		source =
				let
				    Fonte = MySQL.Database("localhost:3306", "ppgcd_artflix_random", [ReturnSingleDatabase=true]),
