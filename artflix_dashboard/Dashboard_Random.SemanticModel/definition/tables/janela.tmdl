		variation Variation
			isDefault
			relationship: 7688ac58-2c54-44e5-b550-95cf1495e205
			defaultHierarchy: LocalDateTable_7207f18b-e6ca-4883-8cd0-495a8f847a3c.'Hierarquia de datas'

